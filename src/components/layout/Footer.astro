---
import { navigation } from '../../data/navigation';
import { site } from '../../data/site';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';

const year = new Date().getFullYear();
const { labels } = site;
const linkClass =
  'inline-flex min-h-11 items-center text-body-md underline-offset-4 hover:underline focus-visible:outline-inverse-on-surface';
---

<footer class="border-t border-hairline-inverse bg-inverse-surface text-inverse-on-surface">
  <div class="mx-auto max-w-site px-margin py-space-xl">
    <div class="grid grid-cols-1 gap-space-lg md:grid-cols-3 md:gap-gutter">
      <!-- Marque -->
      <div class="flex flex-col gap-4">
        <a href="/" class="w-fit focus-visible:outline-inverse-on-surface" aria-label={labels.homeAria}>
          <Logo variant="on-dark" class="text-lg" />
        </a>
        <p class="max-w-xs text-body-md text-inverse-on-surface/80">
          {site.description}
        </p>
        <ul class="mt-2 flex items-center gap-3">
          {
            site.socials.map((social) => (
              <li>
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.name}
                  class="flex h-11 w-11 items-center justify-center rounded-full border border-inverse-on-surface text-inverse-on-surface transition-colors focus-visible:outline-inverse-on-surface hover:border-inverse-on-surface hover:bg-hairline-inverse"
                >
                  <Icon name={social.icon} class="h-5 w-5" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Plan du site -->
      <nav aria-label={labels.footerNav} class="flex flex-col gap-4">
        <span class="label-md text-inverse-on-surface/80">
          {labels.footerNavTitle}
        </span>
        <ul class="flex flex-col">
          {
            [...navigation.links, navigation.cta].map((link) => (
              <li>
                <a href={link.href} class={linkClass}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact -->
      <div class="flex flex-col gap-1">
        <span class="mb-3 label-md text-inverse-on-surface/80">
          {labels.footerContactTitle}
        </span>
        <a href={`mailto:${site.email}`} class={`gap-3 ${linkClass}`}>
          <Icon name="mail" class="h-5 w-5" />{site.email}
        </a>
        <a href={site.phone.href} class={`gap-3 ${linkClass}`}>
          <Icon name="phone" class="h-5 w-5" />{site.phone.display}
        </a>
        <a
          href={site.address.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={`gap-3 ${linkClass}`}
        >
          <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0" />
          <span>{site.address.street}<br />{site.address.city}</span>
        </a>
      </div>
    </div>

    <p class="mt-12 border-t border-hairline-inverse pt-8 text-body-sm text-inverse-on-surface/80">
      © {year} {site.name} - {site.legalLine}
    </p>
  </div>
</footer>
