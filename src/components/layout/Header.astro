---
import { navigation } from '../../data/navigation';
import { site } from '../../data/site';
import { signature } from '../../data/home';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import NavCell from '../ui/NavCell.astro';
import Icon from '../ui/Icon.astro';
import MegaMenu from './MegaMenu.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  // Pose le header transparent au-dessus d'un hero photo, solidifié au scroll.
  overHero?: boolean;
}

const { overHero = false } = Astro.props;

const normalize = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const currentPath = normalize(Astro.url.pathname);
const ariaCurrent = (href: string) =>
  !href.includes('#') && normalize(href) === currentPath ? 'page' : undefined;
const { labels } = site;

const headerClass = overHero
  ? 'border-b border-transparent'
  : 'is-solid border-b border-hairline bg-surface-container-lowest';
---

<!-- Le header est toujours fixe : la réserve h-20 évite tout saut de layout à la compaction. -->
<div class:list={[!overHero && 'h-20']}>
  <header
    id="site-header"
    data-over-hero={overHero ? '' : undefined}
    class:list={['fixed inset-x-0 top-0 z-50 transition-colors duration-200', headerClass]}
  >
    <div
      class="header-row mx-auto flex h-20 max-w-site wide:max-w-none items-stretch justify-between px-margin transition-[height] duration-200 motion-reduce:transition-none desktop:px-0 in-[.is-compact]:h-16"
    >
      <a
        href="/"
        class="header-control flex shrink-0 items-center text-lg text-(--nav-fg) transition-[font-size] duration-200 focus-visible:outline-(--nav-fg) motion-reduce:transition-none desktop:border-r desktop:border-(--nav-line) desktop:pr-space-lg desktop:pl-margin in-[.is-compact]:text-base"
        aria-label={labels.homeAria}
      >
        <Logo
          variant={overHero ? 'adaptive' : 'on-light'}
          signature={{
            trade: site.labels.trade,
            slogan: signature.slogan,
            since: `${site.labels.since} ${site.foundedYear}`,
          }}
        />
      </a>

      <nav class="hidden flex-1 desktop:flex" aria-label={labels.mainNav}>
        {
          navigation.links.map((link, i) => {
            const menu = link.menu ? navigation.menus[link.menu] : undefined;
            const panelId = `mega-${link.menu}`;
            return (
              <div
                class="group/item flex min-w-fit flex-1 border-r border-(--nav-line)"
                data-nav-item
              >
                <NavCell href={link.href} index={i} aria-current={ariaCurrent(link.href)} class="flex-1">
                  {link.label}
                </NavCell>
                {menu && (
                  <>
                    <NavCell
                      data-mega-toggle
                      aria-expanded="false"
                      aria-controls={panelId}
                      aria-label={`${link.label} — ${labels.submenuToggle}`}
                      class="w-11 shrink-0 justify-center px-0"
                    >
                      <Icon
                        name="chevron-down"
                        class="h-5 w-5 transition-transform duration-200 group-aria-expanded/cell:rotate-180 motion-reduce:transition-none"
                      />
                    </NavCell>
                    <MegaMenu id={panelId} label={`${labels.metiersMenu} — ${link.label}`} menu={menu} />
                  </>
                )}
              </div>
            );
          })
        }
      </nav>

      <div class="hidden shrink-0 items-center pr-margin pl-space-md whitespace-nowrap desktop:flex">
        <Button variant={overHero ? 'primary-adaptive' : 'primary'} href={navigation.cta.href}>
          {navigation.cta.label}
        </Button>
      </div>

      <MobileMenu ariaCurrent={ariaCurrent} />
    </div>
  </header>
</div>

<style>
  header {
    --nav-fg: var(--color-on-surface);
    --nav-line: var(--color-hairline);
    --nav-inv-bg: var(--color-obsidian);
    --nav-inv-fg: var(--color-on-primary);
  }
  header[data-over-hero]:not(.is-solid) {
    --nav-fg: var(--color-on-primary);
    --nav-line: color-mix(in srgb, var(--color-on-primary) 30%, transparent);
    --nav-inv-bg: var(--color-on-primary);
    --nav-inv-fg: var(--color-obsidian);
  }
  header[data-over-hero].is-solid {
    background-color: var(--color-surface-container-lowest);
    border-bottom-color: var(--color-hairline);
  }
  header[data-over-hero]:not(.is-solid) a.header-control :global(.logo-on-light) {
    display: none;
  }
  header[data-over-hero]:not(.is-solid) a.header-control :global(.logo-adaptive-dark) {
    display: block;
  }
</style>

<script>
  // Header : compaction au scroll ; solide dès le scroll ou panneau ouvert (variante sur hero).
  const header = document.getElementById('site-header');
  if (header) {
    const overHero = header.hasAttribute('data-over-hero');
    let panelOpen = false;
    const update = () => {
      const scrolled = window.scrollY > 60;
      header.classList.toggle('is-compact', scrolled);
      if (overHero) header.classList.toggle('is-solid', scrolled || panelOpen);
    };
    document.addEventListener('megamenu:change', (e) => {
      panelOpen = (e as CustomEvent<{ open: boolean }>).detail.open;
      update();
    });
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
