---
import { navigation } from '../../data/navigation';
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  // Pose le header transparent au-dessus d'un hero photo, solidifié au scroll.
  overHero?: boolean;
}

const { overHero = false } = Astro.props;

const headerClass = overHero
  ? 'fixed inset-x-0 top-0 z-50 transition-colors'
  : 'sticky top-0 z-50 border-b border-outline-variant bg-surface-container-lowest transition-colors';
---

<header id="site-header" data-over-hero={overHero ? '' : undefined} class={headerClass}>
  <div
    class="mx-auto flex h-20 max-w-[1280px] items-center justify-between gap-8 px-4 sm:px-8 lg:px-16"
  >
    <a href="#top" class="shrink-0" aria-label={`${site.name} — accueil`}>
      <img
        src={site.logo.mark}
        alt=""
        width="48"
        height="48"
        class="header-logo h-12 w-auto"
        decoding="async"
      />
    </a>

    <!-- Navigation desktop -->
    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navigation principale">
      {
        navigation.links.map((link) => (
          <a
            href={link.href}
            class="header-control text-sm font-semibold uppercase tracking-[0.05em] text-on-surface underline-offset-4 hover:underline hover:decoration-2"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <Button variant="accent" href={navigation.cta.href}>{navigation.cta.label}</Button>
    </div>

    <!-- Burger mobile -->
    <button
      type="button"
      id="menu-open"
      class="header-control flex h-12 w-12 items-center justify-center text-on-surface lg:hidden"
      aria-label="Ouvrir le menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <Icon name="menu" class="h-7 w-7" />
    </button>
  </div>

  <!-- Drawer mobile -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 hidden bg-surface-container-lowest lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
  >
    <div class="flex h-20 items-center justify-between border-b border-outline-variant px-4 sm:px-8">
      <img src={site.logo.mark} alt="" width="48" height="48" class="h-12 w-auto" />
      <button
        type="button"
        id="menu-close"
        class="flex h-12 w-12 items-center justify-center text-on-surface"
        aria-label="Fermer le menu"
      >
        <Icon name="close" class="h-7 w-7" />
      </button>
    </div>

    <nav class="flex flex-col px-4 sm:px-8" aria-label="Navigation principale mobile">
      {
        navigation.links.map((link) => (
          <a
            href={link.href}
            class="border-b border-outline-variant py-5 font-display text-2xl font-bold text-on-surface"
            data-menu-link
          >
            {link.label}
          </a>
        ))
      }
      <Button variant="accent" href={navigation.cta.href} class="mt-8 w-full" data-menu-link>
        {navigation.cta.label}
      </Button>
    </nav>
  </div>
</header>

<style>
  /* Header au-dessus du hero : transparent sur la photo, contenu en blanc.
     Solidifié au scroll via la classe .is-solid (ajoutée par le script). */
  header[data-over-hero] .header-control {
    color: var(--color-on-primary);
    transition: color 0.2s ease;
  }
  header[data-over-hero].is-solid {
    background-color: var(--color-surface-container-lowest);
    border-bottom: 1px solid var(--color-outline-variant);
  }
  header[data-over-hero].is-solid .header-control {
    color: var(--color-on-surface);
  }
  header[data-over-hero]:not(.is-solid) .header-logo {
    filter: brightness(0) invert(1);
  }
</style>

<script>
  const menu = document.getElementById('mobile-menu');
  const openBtn = document.getElementById('menu-open');
  const closeBtn = document.getElementById('menu-close');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    openBtn?.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('overflow-hidden', open);
    if (open) closeBtn?.focus();
    else openBtn?.focus();
  };

  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  menu
    ?.querySelectorAll('[data-menu-link]')
    .forEach((link) => link.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) setOpen(false);
  });

  // Focus trap : maintient le focus dans le drawer ouvert (aria-modal).
  menu?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const items = menu.querySelectorAll<HTMLElement>('a, button');
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Header transparent → solidifié dès qu'on quitte le haut du hero.
  const header = document.getElementById('site-header');
  if (header?.hasAttribute('data-over-hero')) {
    const onScroll = () => header.classList.toggle('is-solid', window.scrollY > 60);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
