---
import { responsiveSrcset } from '../../lib/url';
// Carte d'aiguillage : image monochrome teintée qui repasse en couleur au survol/focus.
// Toute la carte est cliquable via le lien étiré posé sur le titre.
import type { HeroSlide } from '../../data/home';
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
  /** Repère mono affiché sur l'image (ex. « PL. 01 // ESPACE PARTICULIERS »). */
  tag: string;
  tagline: string;
  image: Pick<HeroSlide, 'src' | 'alt' | 'width' | 'height'>;
  class?: string;
}

const { href, label, tag, tagline, image, class: className = '' } = Astro.props;
---

<div
  class={`group relative flex flex-col border border-hairline p-space-md transition-colors hover:border-obsidian focus-within:border-obsidian ${className}`}
>
  <div class="relative isolate aspect-video overflow-hidden border border-hairline">
    <img
      src={image.src}
      srcset={responsiveSrcset(image.src)}
      sizes="(min-width: 75rem) 40rem, 100vw"
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0 group-focus-within:grayscale-0 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    />
    <span
      class="pointer-events-none absolute inset-0 bg-tertiary mix-blend-overlay transition-opacity duration-700 group-hover:opacity-0 group-focus-within:opacity-0 motion-reduce:transition-none"
      aria-hidden="true"></span>
    <span
      class="absolute left-0 top-0 bg-obsidian px-space-md py-space-sm label-sm text-on-primary"
      aria-hidden="true"
    >
      {tag}
    </span>
  </div>

  <div class="mt-space-md flex items-start justify-between gap-space-md">
    <div class="flex flex-col gap-space-sm">
      <h3 class="font-display text-headline-md text-on-surface">
        <a
          href={href}
          class="after:absolute after:inset-0 focus-visible:outline-offset-4"
        >
          {label}
        </a>
      </h3>
      <p class="max-w-prose text-body-md text-on-surface-editorial">{tagline}</p>
    </div>
    <span
      class="inline-flex h-11 w-11 shrink-0 items-center justify-center border border-obsidian text-on-surface transition-colors group-hover:bg-obsidian group-hover:text-on-primary group-focus-within:bg-obsidian group-focus-within:text-on-primary"
      aria-hidden="true"
    >
      <Icon name="arrow-right" class="h-4 w-4 -rotate-45" />
    </span>
  </div>
</div>
