---
// Entête de section : eyebrow MAJUSCULES + titre. Réutilisé par toutes les sections.
interface Props {
  eyebrow: string;
  title: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  class?: string;
}

const { eyebrow, title, align = 'left', tone = 'light', class: className = '' } = Astro.props;
const isCenter = align === 'center';
const isDark = tone === 'dark';
const textColor = isDark ? 'text-inverse-on-surface' : 'text-on-surface';
const markerColor = isDark ? 'bg-inverse-on-surface' : 'bg-obsidian';
---

<div class={`flex flex-col gap-4 ${isCenter ? 'items-center text-center' : ''} ${className}`}>
  <span class={`flex items-center gap-3 label-md ${textColor}`}>
    <span class={`h-2 w-2 ${markerColor}`} aria-hidden="true"></span>
    {eyebrow}
  </span>
  <h2 class={`max-w-3xl font-display text-headline-lg-mobile md:text-headline-lg ${textColor}`}>
    {title}
  </h2>
</div>
