---
// Maison interactive — HYBRIDE (photo + calque vectoriel).
// Source : _exploration-maison/ (zones.py + gen2.py).
// 12 data-id = corps-metier.ts (DRY).
import { corpsMetier } from '../../data/corps-metier';
import { metierPath } from '../../lib/url';
import SectionHeading from '../ui/SectionHeading.astro';
const byId = Object.fromEntries(corpsMetier.map((c) => [c.id, c]));
const hrefFor = (id: string) => metierPath(byId[id].slug);
const labelFor = (id: string) => byId[id].nom;
---

<section id="expertises" class="border-b border-hairline bg-surface">
  <div class="mx-auto max-w-site px-margin py-space-xl desktop:py-space-2xl">
    <SectionHeading eyebrow="Expertises" title="Un savoir-faire complet, du gros œuvre aux finitions." class="mb-4" />
    <p class="mb-12 max-w-2xl text-body-lg text-on-surface-variant">
      Tous les corps de métier de votre chantier, maîtrisés en interne et coordonnés
      par un seul interlocuteur, du devis à la remise des clés.
    </p>

