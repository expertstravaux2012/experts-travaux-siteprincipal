      <a class="zone" data-id="maconnerie" href={hrefFor('maconnerie')} tabindex="-1" aria-hidden="true" aria-label={labelFor('maconnerie')}><title>{labelFor('maconnerie')}</title><image class="maison-color" data-href="/assets/maison-coupe.webp" x="290" y="170.9" width="1000" height="558.1" preserveAspectRatio="xMidYMid meet" clip-path="url(#clip-maconnerie)" aria-hidden="true"/><polygon id="hit-maconnerie-0" class="hit" points="471.0,446.9 499.0,438.9 502.5,490.9 502.5,575.9 440.0,570.9 426.0,550.9 451.0,500.9"/></a>
      <a class="zone" data-id="extension" href={hrefFor('extension')} tabindex="-1" aria-hidden="true" aria-label={labelFor('extension')}><title>{labelFor('extension')}</title><image class="maison-color" data-href="/assets/maison-coupe.webp" x="290" y="170.9" width="1000" height="558.1" preserveAspectRatio="xMidYMid meet" clip-path="url(#clip-extension)" aria-hidden="true"/><polygon id="hit-extension-0" class="hit" points="1099.0,350.0 1143.0,356.0 1143.0,528.0 1099.0,522.0"/></a>
