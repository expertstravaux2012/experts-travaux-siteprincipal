---
import { site } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

// Champs du formulaire de devis. Traitement back à brancher ultérieurement.
const fieldClass =
  'w-full border border-outline bg-surface-container-lowest px-4 py-4 text-base text-on-surface placeholder:text-on-surface-variant focus:border-b-[3px] focus:border-b-tertiary';
---

<section id="contact" class="bg-surface">
  <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-12 px-4 py-16 sm:px-8 lg:grid-cols-2 lg:px-16 lg:py-24">
    <!-- Colonne info -->
    <div class="flex flex-col gap-8">
      <SectionHeading
        eyebrow="Contact / Devis"
        title="Parlons de votre projet. Devis gratuit sous 48 h."
      />
      <p class="max-w-md text-lg leading-relaxed text-on-surface-variant">
        Décrivez-nous votre projet : nous revenons vers vous rapidement pour une visite et un chiffrage clair, sans engagement.
      </p>

      <div class="flex flex-col gap-5 border-l-2 border-primary pl-4">
        <a href={`mailto:${site.email}`} class="inline-flex w-fit items-center gap-3 text-base text-on-surface underline-offset-4 hover:underline">
          <Icon name="mail" class="h-5 w-5 text-primary" />{site.email}
        </a>
        <a href={site.phone.href} class="inline-flex w-fit items-center gap-3 text-base text-on-surface underline-offset-4 hover:underline">
          <Icon name="phone" class="h-5 w-5 text-primary" />{site.phone.display}
        </a>
        <a
          href={site.address.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-fit items-start gap-3 text-base text-on-surface underline-offset-4 hover:underline"
        >
          <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
          <span>{site.address.street}<br />{site.address.city}</span>
        </a>
      </div>
    </div>

    <!-- Formulaire -->
    <form class="flex flex-col gap-5 border border-outline-variant bg-surface-container-lowest p-6 sm:p-8">
      <div class="flex flex-col gap-2">
        <label for="nom" class="text-sm font-semibold uppercase tracking-[0.05em] text-on-surface">Nom</label>
        <input id="nom" name="nom" type="text" autocomplete="name" required class={fieldClass} placeholder="Votre nom" />
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="flex flex-col gap-2">
          <label for="email" class="text-sm font-semibold uppercase tracking-[0.05em] text-on-surface">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={fieldClass} placeholder="vous@exemple.fr" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="tel" class="text-sm font-semibold uppercase tracking-[0.05em] text-on-surface">Téléphone</label>
          <input id="tel" name="tel" type="tel" autocomplete="tel" class={fieldClass} placeholder="06 12 34 56 78" />
        </div>
      </div>
      <div class="flex flex-col gap-2">
        <label for="projet" class="text-sm font-semibold uppercase tracking-[0.05em] text-on-surface">Votre projet</label>
        <textarea id="projet" name="projet" rows="4" required class={fieldClass} placeholder="Extension, rénovation, cuisine…"></textarea>
      </div>
      <Button variant="accent" type="submit" class="w-full">Envoyer ma demande</Button>
    </form>
  </div>
</section>
