---
import { apropos } from '../../data/home';
---

<section id="apropos" class="border-b border-outline-variant bg-inverse-surface text-inverse-on-surface">
  <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-12 px-4 py-16 sm:px-8 lg:grid-cols-2 lg:px-16 lg:py-24">
    <!-- Texte -->
    <div class="flex flex-col gap-6">
      <span class="flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.05em]">
        <span class="h-2 w-2 bg-tertiary" aria-hidden="true"></span>
        {apropos.eyebrow}
      </span>
      <h2 class="max-w-xl font-display text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
        {apropos.title}
      </h2>
      {apropos.paragraphs.map((p) => <p class="max-w-xl text-lg leading-relaxed text-inverse-on-surface/80">{p}</p>)}
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 gap-px self-center border border-inverse-on-surface/20 bg-inverse-on-surface/20 sm:grid-cols-3 lg:grid-cols-1">
      {
        apropos.stats.map((stat) => (
          <div class="flex flex-col gap-2 bg-inverse-surface p-8">
            <span class="font-display text-4xl font-extrabold text-tertiary">{stat.valeur}</span>
            <span class="text-base uppercase tracking-[0.05em] text-inverse-on-surface/70">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
