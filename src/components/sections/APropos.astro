---
import { apropos, chiffresCles } from '../../data/home';

const preuves = chiffresCles.flatMap(({ valeur, label }) => (valeur === null ? [] : [{ valeur, label }]));
const stats = [...apropos.stats, ...preuves];
---

<section id="apropos" class="border-b border-hairline-inverse bg-inverse-surface text-inverse-on-surface">
  <div class="mx-auto grid max-w-site grid-cols-1 gap-space-lg px-margin py-space-xl desktop:grid-cols-12 desktop:gap-gutter desktop:py-space-2xl">
    <!-- Texte -->
    <div class="flex flex-col gap-space-md desktop:col-span-7">
      <span class="flex items-center gap-3 label-md">
        <span class="h-2 w-2 bg-inverse-on-surface" aria-hidden="true"></span>
        {apropos.eyebrow}
      </span>
      <h2 class="max-w-xl font-display text-headline-md md:text-headline-lg">
        {apropos.title}
      </h2>
      {apropos.paragraphs.map((p) => <p class="max-w-xl text-body-lg text-inverse-on-surface/80">{p}</p>)}
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 gap-px self-center border border-hairline-inverse bg-hairline-inverse md:grid-cols-3 desktop:col-span-5 desktop:grid-cols-1">
      {
        stats.map((stat) => (
          <div class="flex flex-col gap-2 bg-inverse-surface p-space-lg">
            <span class="font-display text-headline-lg text-inverse-on-surface">{stat.valeur}</span>
            <span class="label-md text-inverse-on-surface/80">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
