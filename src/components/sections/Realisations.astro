---
import { realisations } from '../../data/realisations';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
---

<section id="realisations" class="border-b border-outline-variant bg-surface-container-low">
  <div class="mx-auto max-w-[1280px] px-4 py-16 sm:px-8 lg:px-16 lg:py-24">
    <div class="mb-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading
        eyebrow="Réalisations"
        title="Des chantiers livrés, partout à Toulouse."
      />
      <Button variant="secondary" href="#contact" icon="arrow-right" class="shrink-0">
        Discuter de mon projet
      </Button>
    </div>

    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        realisations.map((real) => (
          <li class="group relative aspect-[4/3] overflow-hidden border border-outline-variant">
            <img
              src={real.image}
              alt={real.alt}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            <span class="absolute left-0 top-0 bg-primary px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.05em] text-on-primary">
              {real.categorie}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
