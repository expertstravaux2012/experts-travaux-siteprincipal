---
import { realisations } from '../../data/realisations';
import { realisationsSection } from '../../data/home';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import RealisationCard from '../ui/RealisationCard.astro';

const layouts = {
  large: { span: 'desktop:col-span-8', image: 'aspect-4/3' },
  small: { span: 'desktop:col-span-4', image: 'aspect-4/3 desktop:aspect-3/4' },
  half: { span: 'desktop:col-span-6', image: 'aspect-4/3' },
} as const;

const pattern = ['large', 'small', 'small', 'large', 'half', 'half'] as const;
---

<section id="realisations" class="bg-inverse-surface text-inverse-on-surface">
  <div class="mx-auto max-w-site px-margin py-space-xl desktop:py-space-2xl">
    <div class="mb-space-xl flex flex-col gap-space-md md:flex-row md:items-end md:justify-between">
      <SectionHeading
        tone="dark"
        eyebrow={realisationsSection.eyebrow}
        title={realisationsSection.title}
      />
      <Button variant="secondary-light" href={realisationsSection.cta.href} icon="arrow-right" class="shrink-0">
        {realisationsSection.cta.label}
      </Button>
    </div>

    <ul class="grid grid-cols-1 items-start gap-gutter md:grid-cols-2 desktop:grid-cols-12">
      {
        realisations.map((real, index) => {
          const layout = layouts[pattern[index] ?? 'half'];
          return (
            <RealisationCard
              realisation={real}
              index={index}
              labels={realisationsSection.labels}
              class={layout.span}
              imageClass={layout.image}
            />
          );
        })
      }
    </ul>
  </div>
</section>
