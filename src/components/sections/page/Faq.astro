---
// FAQ accessible en <details>/<summary>. Les paires Q/R pour JSON-LD : voir src/lib/faq-jsonld.ts.
import type { FaqItem } from '../../../data/home';
import Section from '../../ui/Section.astro';
import SectionHeading from '../../ui/SectionHeading.astro';

interface Props {
  eyebrow: string;
  title: string;
  items: FaqItem[];
}

const { eyebrow, title, items } = Astro.props;
---

<Section>
  <div class="grid grid-cols-1 gap-space-lg desktop:grid-cols-12 desktop:gap-gutter">
    <SectionHeading eyebrow={eyebrow} title={title} class="desktop:col-span-5" />
    <div class="border-t border-hairline desktop:col-span-7">
      {
        items.map((item) => (
          <details class="group border-b border-hairline">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-space-md py-space-md text-title-md text-on-surface marker:hidden [&::-webkit-details-marker]:hidden">
              <span>{item.question}</span>
              <span class="label-md shrink-0" aria-hidden="true">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">−</span>
              </span>
            </summary>
            <p class="max-w-prose pb-space-lg text-body-md text-on-surface-variant">{item.reponse}</p>
          </details>
        ))
      }
    </div>
  </div>
</Section>
