---
// En-tête de page : fil d'Ariane (slot "breadcrumb"), eyebrow, H1 unique, intro, actions (slot par défaut).
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="border-b border-hairline bg-surface">
  <div class="mx-auto max-w-site px-margin pb-space-xl pt-space-lg desktop:pb-space-2xl">
    <slot name="breadcrumb" />
    <div class="mt-space-lg grid grid-cols-1 gap-space-lg desktop:grid-cols-12 desktop:gap-gutter">
      <div class="flex flex-col gap-space-md desktop:col-span-7">
        <span class="flex items-center gap-3 label-md text-on-surface">
          <span class="h-2 w-2 bg-obsidian" aria-hidden="true"></span>
          {eyebrow}
        </span>
        <h1 class="font-display text-balance text-headline-lg-mobile text-on-surface md:text-display-xl-mobile desktop:text-display-xl">
          {title}
        </h1>
      </div>
      <div class="flex flex-col gap-space-lg desktop:col-span-5 desktop:border-l desktop:border-hairline desktop:pl-gutter">
        <p class="text-body-lg text-on-surface-editorial">{intro}</p>
        <div class="flex flex-wrap gap-space-md"><slot /></div>
      </div>
    </div>
  </div>
</section>
