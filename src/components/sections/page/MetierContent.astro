---
// Contenu d'une page métier : prestations (puces carrées), pourquoi, cibles (chips).
import type { CorpsMetierPage } from '../../../data/corps-metier';
import { cibleLabels, ciblesDe, metierPage, silos } from '../../../data/pages';
import Section from '../../ui/Section.astro';
import SectionHeading from '../../ui/SectionHeading.astro';
import SquareList from '../../ui/SquareList.astro';
import Chip from '../../ui/Chip.astro';

interface Props {
  page: CorpsMetierPage;
}

const { page } = Astro.props;
const cibles = ciblesDe(page.cibles);
---

<Section>
  <div class="grid grid-cols-1 gap-space-xl desktop:grid-cols-12 desktop:gap-gutter">
    <div class="flex flex-col gap-space-lg desktop:col-span-5">
      <SectionHeading eyebrow={metierPage.prestationsHeading.eyebrow} title={metierPage.prestationsHeading.title} />
      <SquareList items={page.prestations} />
    </div>
    <div class="flex flex-col gap-space-lg desktop:col-span-7 desktop:border-l desktop:border-hairline desktop:pl-gutter">
      <SectionHeading eyebrow={metierPage.pourquoiHeading.eyebrow} title={metierPage.pourquoiHeading.title} />
      <p class="text-body-lg text-on-surface-editorial">{page.pourquoi}</p>
      <div class="flex flex-col gap-space-sm border-t border-hairline pt-space-lg">
        <h2 class="label-md text-on-surface">{metierPage.cibleHeading.title}</h2>
        <ul class="flex flex-wrap gap-space-sm">
          {
            cibles.map((cible) => (
              <li>
                <Chip href={silos[cible].href}>{cibleLabels[cible]}</Chip>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Section>
