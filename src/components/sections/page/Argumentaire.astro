---
import type { Argument } from '../../../data/professionnels';
import Section from '../../ui/Section.astro';
import SectionHeading from '../../ui/SectionHeading.astro';

interface Props {
  eyebrow: string;
  title: string;
  items: Argument[];
}

const { eyebrow, title, items } = Astro.props;
---

<Section>
  <div class="grid grid-cols-1 gap-space-xl desktop:grid-cols-12 desktop:gap-gutter">
    <SectionHeading eyebrow={eyebrow} title={title} class="desktop:col-span-5" />
    <dl class="grid grid-cols-1 gap-px border border-hairline bg-hairline md:grid-cols-2 desktop:col-span-7">
      {
        items.map((arg) => (
          <div class="flex flex-col gap-space-sm bg-surface-container-lowest p-space-lg">
            <dt class="font-sans text-headline-sm text-on-surface">{arg.titre}</dt>
            <dd class="text-body-md text-on-surface-variant">{arg.texte}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>
