---
import { methodeSection } from '../../data/home';
import { etapes, garanties } from '../../data/methode';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
---

<section id="methode" class="border-b border-hairline bg-surface">
  <div class="mx-auto max-w-site px-margin py-space-xl desktop:py-space-2xl">
    <SectionHeading
      eyebrow={methodeSection.eyebrow}
      title={methodeSection.title}
      class="mb-12"
    />

    <!-- Étapes -->
    <ol class="grid grid-cols-1 gap-px border border-hairline bg-hairline md:grid-cols-2 desktop:grid-cols-4">
      {
        etapes.map((etape) => (
          <li class="flex flex-col gap-3 bg-surface-container-lowest p-6">
            <span class="font-display text-headline-lg text-on-surface">{etape.numero}</span>
            <h3 class="font-sans text-headline-sm text-on-surface">{etape.titre}</h3>
            <p class="text-body-md text-on-surface-variant">{etape.description}</p>
          </li>
        ))
      }
    </ol>

    <!-- Garanties -->
    <ul class="mt-12 grid grid-cols-1 gap-gutter md:grid-cols-2 desktop:grid-cols-4">
      {
        garanties.map((g) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center bg-obsidian text-on-primary">
              <Icon name="check" class="h-4 w-4" />
            </span>
            <div class="flex flex-col gap-1">
              <h3 class="font-sans text-title-md text-on-surface">{g.titre}</h3>
              <span class="text-body-sm text-on-surface-variant">{g.description}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
