---
// Maison interactive v2 — perspective isometrique 3/4 (coupe de coin).
// EXPLORATION : variante a comparer avec MaisonInteractive.astro (line-art).
// Contrat identique : 12 data-id = corps-metier.ts (source de verite unique, DRY).
// Geometrie generee par projection iso (cf. _exploration-maison/gen.py).
import { corpsMetier } from '../src/data/corps-metier';
import SectionHeading from '../src/components/ui/SectionHeading.astro';

const byId = Object.fromEntries(corpsMetier.map((c) => [c.id, c]));
const hrefFor = (id: string) => `/metiers/${byId[id].slug}`;
const labelFor = (id: string) => byId[id].nom;
---

<section id="expertises" class="border-b border-outline-variant bg-surface">
  <div class="mx-auto max-w-[1280px] px-4 py-16 sm:px-8 lg:px-16 lg:py-24">
    <SectionHeading eyebrow="Expertises" title="Un savoir-faire complet, du gros œuvre aux finitions." class="mb-4" />
    <p class="mb-12 max-w-2xl text-lg leading-relaxed text-on-surface-variant">
      Tous les corps de métier de votre chantier, maîtrisés en interne et coordonnés
      par un seul interlocuteur, du devis à la remise des clés.
    </p>

    <div class="maison mx-auto mb-10 max-w-5xl border border-outline-variant bg-surface-container-lowest p-6 sm:p-10">
      <svg viewBox="0 0 1380 840"  role="img" aria-label="Coupe isometrique d'une maison ; chaque partie est un lien vers un corps de metier."><style>
      .fnd-top{fill:var(--color-surface-container-high);stroke:var(--color-on-surface);stroke-width:1.5}
      .fnd-r{fill:var(--color-outline);stroke:var(--color-on-surface);stroke-width:1.5}
      .fnd-l{fill:var(--color-outline-variant);stroke:var(--color-on-surface);stroke-width:1.5}
      .in-far{fill:var(--color-surface-container-low);stroke:var(--color-outline-variant);stroke-width:1}
      .in-side{fill:var(--color-surface-container-high);stroke:var(--color-outline-variant);stroke-width:1}
      .floor-top{fill:var(--color-surface-container);stroke:var(--color-on-surface);stroke-width:1.4}
      .floor-edge{fill:var(--color-outline-variant);stroke:var(--color-on-surface);stroke-width:1.4}
      .in-line{stroke:var(--color-outline-variant);stroke-width:1}
      .roof-back{fill:var(--color-outline-variant);stroke:var(--color-on-surface);stroke-width:1.5}
      .gable-r{fill:var(--color-surface-container-high);stroke:var(--color-on-surface);stroke-width:1.5}
      .hit{fill:transparent;stroke:none}
      .lead{stroke:var(--color-outline);stroke-width:1;fill:none}
      .leaddot{fill:var(--color-tertiary)}
      .ltxt{font:600 14px system-ui,-apple-system,Segoe UI,Arial,sans-serif;fill:var(--color-on-surface)}
      /* art par zone */
      .facade-fill{fill:var(--color-surface-container);stroke:var(--color-on-surface);stroke-width:1.6}
      .facade-band{stroke:var(--color-tertiary);stroke-width:3}
      .roof-front{fill:var(--color-tertiary-container);stroke:var(--color-on-surface);stroke-width:1.6}
      .tile{stroke:var(--color-tertiary);stroke-width:1;opacity:.5}
      .truss{stroke:var(--color-on-surface);stroke-width:2;fill:none;stroke-linecap:round}
      .truss-thin{stroke:var(--color-on-surface-variant);stroke-width:1.2;fill:none}
      .iso-wave{stroke:var(--color-tertiary);stroke-width:2;fill:none;opacity:.8}
      .win{fill:var(--color-secondary-container);stroke:var(--color-on-surface);stroke-width:1.4}
      .winbar{stroke:var(--color-on-surface);stroke-width:1}
      .ext-t{fill:var(--color-surface-container-high);stroke:var(--color-on-surface);stroke-width:1.5}
      .ext-l{fill:var(--color-outline-variant);stroke:var(--color-on-surface);stroke-width:1.5}
      .ext-f{fill:var(--color-surface-container);stroke:var(--color-on-surface);stroke-width:1.5}
      .wood-t{fill:var(--color-tertiary-container);stroke:var(--color-on-surface);stroke-width:1.2}
      .wood-f{fill:var(--color-tertiary-container);stroke:var(--color-on-surface);stroke-width:1.2;opacity:.85}
      .wood-s{fill:var(--color-tertiary-container);stroke:var(--color-on-surface);stroke-width:1.2;opacity:.7}
      .unit-t{fill:var(--color-surface-container);stroke:var(--color-on-surface);stroke-width:1.2}
      .unit-f{fill:var(--color-surface-container-high);stroke:var(--color-on-surface);stroke-width:1.2}
      .unit-s{fill:var(--color-outline-variant);stroke:var(--color-on-surface);stroke-width:1.2}
      .pac-t{fill:var(--color-surface-container);stroke:var(--color-on-surface);stroke-width:1.2}
      .pac-f{fill:var(--color-surface-container-high);stroke:var(--color-on-surface);stroke-width:1.2}
      .pac-s{fill:var(--color-outline-variant);stroke:var(--color-on-surface);stroke-width:1.2}
      .coil{stroke:var(--color-tertiary);stroke-width:1.4;opacity:.7}
      .shower{fill:var(--color-secondary-container);stroke:var(--color-on-surface);stroke-width:1.2;opacity:.8}
      .bglass{fill:var(--color-secondary-container);stroke:var(--color-on-surface);stroke-width:1.2;opacity:.5}
      .fix{stroke:var(--color-on-surface-variant);stroke-width:1.6}
      .panel-t{fill:var(--color-surface-container);stroke:var(--color-on-surface);stroke-width:1.2}
      .panel-f{fill:var(--color-surface-container-high);stroke:var(--color-on-surface);stroke-width:1.2}
      .panel-s{fill:var(--color-outline-variant);stroke:var(--color-on-surface);stroke-width:1.2}
      .cable{stroke:var(--color-tertiary);stroke-width:1.6;fill:none}
      /* interaction */
      .zone{cursor:pointer}
      .zone .hit{transition:fill .15s ease}
      .zone:hover .hit,.zone:focus-visible .hit,.zone.is-active .hit{fill:var(--color-tertiary-container);opacity:.55}
      .zone:focus-visible{outline:none}
      </style>
      <g class="decor" aria-hidden="true">
      <polygon class="fnd-top" points="600.0,491.0 846.0,633.0 641.6,751.0 395.6,609.0" />
      <polygon class="fnd-r" points="600.0,491.0 846.0,633.0 846.0,655.0 600.0,513.0" />
